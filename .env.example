# Contact form email delivery (https://resend.com).
# Without RESEND_API_KEY the form still works: it falls back to the visitor's mail app.
RESEND_API_KEY=
# Where messages are delivered (defaults to zakas2379@gmail.com)
CONTACT_TO=
# Sender shown on the email. The default (onboarding@resend.dev) only delivers to the
# address that owns the Resend account; use an address on a verified domain otherwise.
CONTACT_FROM=

# Optional. The /projects/all carousel reads the GitHub repo list through /api/repos,
# cached for an hour. Without a token GitHub allows 60 requests/hour per IP; with one,
# 5,000. A fine-grained or classic token with no scopes is enough (public repos only).
GITHUB_TOKEN=

# WhatsApp contact. The "WhatsApp" links go to /whatsapp, which redirects to WhatsApp with a
# message typed. Put your number here as digits with the country code, no + or spaces
# (e.g. 923001234567). It stays on the server: it is not in the page or the repository.
# Without it, those links send visitors to the contact form instead.
WHATSAPP_NUMBER=
